# Sao chép file này thành .env rồi sửa cho khớp với Neo4j của bạn
NEO4J_URI=neo4j://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=matkhau123
NEO4J_DATABASE=neo4j
APP_PORT=5000

# Dùng Neo4j Aura (cloud) thay vì Neo4j trên máy: thay 3 dòng đầu bằng thông tin trong file
# Neo4j-xxxx-Created-....txt tải về khi tạo instance, ví dụ:
# NEO4J_URI=neo4j+s://xxxxxxxx.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=...
# và xoá dòng NEO4J_DATABASE
