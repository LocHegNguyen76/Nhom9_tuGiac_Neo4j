// ==========================================================
// Mô hình hoá tứ giác trong hình học phẳng với Neo4j
// File sinh tự động từ data/knowledge.py  (python -m src.seed --export ...)
// Cách dùng: mở Neo4j Browser, bật 'Enable multi statement query editor'
// trong Settings, dán toàn bộ file và chạy.
// ==========================================================

CREATE CONSTRAINT hinh_ma IF NOT EXISTS FOR (h:Hinh) REQUIRE h.ma IS UNIQUE;
CREATE CONSTRAINT tinhchat_ma IF NOT EXISTS FOR (t:TinhChat) REQUIRE t.ma IS UNIQUE;
CREATE CONSTRAINT dauhieu_ma IF NOT EXISTS FOR (d:DauHieu) REQUIRE d.ma IS UNIQUE;
CREATE CONSTRAINT dailuong_ma IF NOT EXISTS FOR (d:DaiLuong) REQUIRE d.ma IS UNIQUE;
CREATE CONSTRAINT congthuc_ma IF NOT EXISTS FOR (c:CongThuc) REQUIRE c.ma IS UNIQUE;

MATCH (n) WHERE n:Hinh OR n:TinhChat OR n:DauHieu OR n:DaiLuong OR n:CongThuc DETACH DELETE n;

UNWIND [{ma: "TU_GIAC", ten: "Tứ giác", cap: 0, cot: 2, dinh_nghia: "Tứ giác ABCD là hình gồm bốn đoạn thẳng AB, BC, CD, DA, trong đó không có hai đoạn thẳng nào cùng nằm trên một đường thẳng. Ở đây ta xét tứ giác lồi."}, {ma: "HINH_THANG", ten: "Hình thang", cap: 1, cot: 1.5, dinh_nghia: "Hình thang là tứ giác có hai cạnh đối song song."}, {ma: "HINH_DIEU", ten: "Hình diều", cap: 1, cot: 3.5, dinh_nghia: "Hình diều (hình cánh diều) là tứ giác có hai cặp cạnh kề bằng nhau (AB = AD và CB = CD)."}, {ma: "HINH_THANG_VUONG", ten: "Hình thang vuông", cap: 2, cot: 0.5, dinh_nghia: "Hình thang vuông là hình thang có một góc vuông."}, {ma: "HINH_THANG_CAN", ten: "Hình thang cân", cap: 2, cot: 1.5, dinh_nghia: "Hình thang cân là hình thang có hai góc kề một đáy bằng nhau."}, {ma: "HINH_BINH_HANH", ten: "Hình bình hành", cap: 2, cot: 2.75, dinh_nghia: "Hình bình hành là tứ giác có các cạnh đối song song."}, {ma: "HINH_CHU_NHAT", ten: "Hình chữ nhật", cap: 3, cot: 1.75, dinh_nghia: "Hình chữ nhật là tứ giác có bốn góc vuông."}, {ma: "HINH_THOI", ten: "Hình thoi", cap: 3, cot: 3.25, dinh_nghia: "Hình thoi là tứ giác có bốn cạnh bằng nhau."}, {ma: "HINH_VUONG", ten: "Hình vuông", cap: 4, cot: 2.5, dinh_nghia: "Hình vuông là tứ giác có bốn góc vuông và bốn cạnh bằng nhau."}] AS r
MERGE (h:Hinh {ma: r.ma})
SET h.ten = r.ten, h.dinh_nghia = r.dinh_nghia, h.cap = r.cap, h.cot = r.cot;

UNWIND [{ma: "SS_1_CAP", nhom: "canh", ten: "Có một cặp cạnh đối song song", nhom_ten: "Về cạnh", thu_tu: 0}, {ma: "SS_2_CAP", nhom: "canh", ten: "Hai cặp cạnh đối song song", nhom_ten: "Về cạnh", thu_tu: 1}, {ma: "BANG_2_CAP", nhom: "canh", ten: "Hai cặp cạnh đối bằng nhau", nhom_ten: "Về cạnh", thu_tu: 2}, {ma: "SS_VA_BANG", nhom: "canh", ten: "Có một cặp cạnh đối vừa song song vừa bằng nhau", nhom_ten: "Về cạnh", thu_tu: 3}, {ma: "CANH_BEN_BANG", nhom: "canh", ten: "Cặp cạnh còn lại (hai cạnh bên) bằng nhau", nhom_ten: "Về cạnh", thu_tu: 4}, {ma: "CANH_BEN_KHONG_SS", nhom: "canh", ten: "Hai cạnh bên không song song", nhom_ten: "Về cạnh", thu_tu: 5}, {ma: "HAI_CANH_KE_BANG", nhom: "canh", ten: "Có hai cạnh kề bằng nhau", nhom_ten: "Về cạnh", thu_tu: 6}, {ma: "HAI_CAP_KE_BANG", nhom: "canh", ten: "Hai cặp cạnh kề bằng nhau (AB = AD, CB = CD)", nhom_ten: "Về cạnh", thu_tu: 7}, {ma: "BON_CANH_BANG", nhom: "canh", ten: "Bốn cạnh bằng nhau", nhom_ten: "Về cạnh", thu_tu: 8}, {ma: "MOT_GOC_VUONG", nhom: "goc", ten: "Có một góc vuông", nhom_ten: "Về góc", thu_tu: 9}, {ma: "BA_GOC_VUONG", nhom: "goc", ten: "Có ba góc vuông", nhom_ten: "Về góc", thu_tu: 10}, {ma: "GOC_DOI_BANG", nhom: "goc", ten: "Các góc đối bằng nhau", nhom_ten: "Về góc", thu_tu: 11}, {ma: "GOC_KE_DAY_BANG", nhom: "goc", ten: "Hai góc kề một đáy bằng nhau", nhom_ten: "Về góc", thu_tu: 12}, {ma: "CHEO_TRUNG_DIEM", nhom: "duong_cheo", ten: "Hai đường chéo cắt nhau tại trung điểm mỗi đường", nhom_ten: "Về đường chéo", thu_tu: 13}, {ma: "CHEO_BANG", nhom: "duong_cheo", ten: "Hai đường chéo bằng nhau", nhom_ten: "Về đường chéo", thu_tu: 14}, {ma: "CHEO_VUONG_GOC", nhom: "duong_cheo", ten: "Hai đường chéo vuông góc với nhau", nhom_ten: "Về đường chéo", thu_tu: 15}, {ma: "CHEO_PHAN_GIAC", nhom: "duong_cheo", ten: "Có một đường chéo là đường phân giác của một góc", nhom_ten: "Về đường chéo", thu_tu: 16}] AS r
MERGE (t:TinhChat {ma: r.ma})
SET t.ten = r.ten, t.nhom = r.nhom, t.nhom_ten = r.nhom_ten, t.thu_tu = r.thu_tu;

UNWIND [{con: "HINH_THANG", cha: "TU_GIAC"}, {con: "HINH_DIEU", cha: "TU_GIAC"}, {con: "HINH_THANG_VUONG", cha: "HINH_THANG"}, {con: "HINH_THANG_CAN", cha: "HINH_THANG"}, {con: "HINH_BINH_HANH", cha: "HINH_THANG"}, {con: "HINH_CHU_NHAT", cha: "HINH_BINH_HANH"}, {con: "HINH_CHU_NHAT", cha: "HINH_THANG_CAN"}, {con: "HINH_CHU_NHAT", cha: "HINH_THANG_VUONG"}, {con: "HINH_THOI", cha: "HINH_BINH_HANH"}, {con: "HINH_THOI", cha: "HINH_DIEU"}, {con: "HINH_VUONG", cha: "HINH_CHU_NHAT"}, {con: "HINH_VUONG", cha: "HINH_THOI"}] AS r
MATCH (c:Hinh {ma: r.con}), (p:Hinh {ma: r.cha})
MERGE (c)-[:LA_MOT]->(p);

UNWIND [{hinh: "HINH_THANG", tc: "SS_1_CAP"}, {hinh: "HINH_DIEU", tc: "HAI_CAP_KE_BANG"}, {hinh: "HINH_DIEU", tc: "HAI_CANH_KE_BANG"}, {hinh: "HINH_DIEU", tc: "CHEO_VUONG_GOC"}, {hinh: "HINH_DIEU", tc: "CHEO_PHAN_GIAC"}, {hinh: "HINH_THANG_VUONG", tc: "MOT_GOC_VUONG"}, {hinh: "HINH_THANG_CAN", tc: "GOC_KE_DAY_BANG"}, {hinh: "HINH_THANG_CAN", tc: "CHEO_BANG"}, {hinh: "HINH_THANG_CAN", tc: "CANH_BEN_BANG"}, {hinh: "HINH_BINH_HANH", tc: "SS_2_CAP"}, {hinh: "HINH_BINH_HANH", tc: "BANG_2_CAP"}, {hinh: "HINH_BINH_HANH", tc: "SS_VA_BANG"}, {hinh: "HINH_BINH_HANH", tc: "GOC_DOI_BANG"}, {hinh: "HINH_BINH_HANH", tc: "CHEO_TRUNG_DIEM"}, {hinh: "HINH_BINH_HANH", tc: "CANH_BEN_BANG"}, {hinh: "HINH_CHU_NHAT", tc: "BA_GOC_VUONG"}, {hinh: "HINH_THOI", tc: "BON_CANH_BANG"}] AS r
MATCH (h:Hinh {ma: r.hinh}), (t:TinhChat {ma: r.tc})
MERGE (h)-[:CO_TINH_CHAT]->(t);

UNWIND [{a: "SS_2_CAP", b: "CANH_BEN_KHONG_SS", ly_do: "Tứ giác có hai cặp cạnh đối song song thì hai cạnh bên cũng song song."}, {a: "CHEO_TRUNG_DIEM", b: "CANH_BEN_KHONG_SS", ly_do: "Hai đường chéo cắt nhau tại trung điểm mỗi đường ⇒ hình bình hành ⇒ hai cạnh bên song song."}, {a: "SS_VA_BANG", b: "CANH_BEN_KHONG_SS", ly_do: "Một cặp cạnh đối vừa song song vừa bằng nhau ⇒ hình bình hành ⇒ hai cạnh bên song song."}, {a: "BANG_2_CAP", b: "CANH_BEN_KHONG_SS", ly_do: "Hai cặp cạnh đối bằng nhau ⇒ hình bình hành ⇒ hai cạnh bên song song."}, {a: "GOC_DOI_BANG", b: "CANH_BEN_KHONG_SS", ly_do: "Các góc đối bằng nhau ⇒ hình bình hành ⇒ hai cạnh bên song song."}] AS r
MATCH (a:TinhChat {ma: r.a}), (b:TinhChat {ma: r.b})
MERGE (a)-[m:MAU_THUAN]->(b) SET m.ly_do = r.ly_do;

UNWIND [{ma: "DH01", ten: "Tứ giác có hai cạnh đối song song là hình thang.", loai: "ket_luan", ghi_chu: "", tru_khi: [], ap_dung: "TU_GIAC", ket_luan: "HINH_THANG", can: ["SS_1_CAP"]}, {ma: "DH02", ten: "Hình thang có một góc vuông là hình thang vuông.", loai: "ket_luan", ghi_chu: "", tru_khi: [], ap_dung: "HINH_THANG", ket_luan: "HINH_THANG_VUONG", can: ["MOT_GOC_VUONG"]}, {ma: "DH03", ten: "Hình thang có hai góc kề một đáy bằng nhau là hình thang cân.", loai: "ket_luan", ghi_chu: "", tru_khi: [], ap_dung: "HINH_THANG", ket_luan: "HINH_THANG_CAN", can: ["GOC_KE_DAY_BANG"]}, {ma: "DH04", ten: "Hình thang có hai đường chéo bằng nhau là hình thang cân.", loai: "ket_luan", ghi_chu: "", tru_khi: [], ap_dung: "HINH_THANG", ket_luan: "HINH_THANG_CAN", can: ["CHEO_BANG"]}, {ma: "DH05", ten: "Hình thang có hai cạnh bên bằng nhau và không song song là hình thang cân.", loai: "ket_luan", ghi_chu: "", tru_khi: [], ap_dung: "HINH_THANG", ket_luan: "HINH_THANG_CAN", can: ["CANH_BEN_BANG", "CANH_BEN_KHONG_SS"]}, {ma: "GY01", ten: "Hình thang có hai cạnh bên bằng nhau CHƯA chắc là hình thang cân.", loai: "goi_y", ghi_chu: "Hình thang có một cặp cạnh song song và cặp cạnh còn lại bằng nhau thì là HÌNH THANG CÂN hoặc HÌNH BÌNH HÀNH. Cần thêm một giả thiết, ví dụ: “hai cạnh bên không song song” (→ hình thang cân) hoặc “hai cặp cạnh đối song song” (→ hình bình hành).", tru_khi: ["HINH_THANG_CAN", "HINH_BINH_HANH"], ap_dung: "HINH_THANG", ket_luan: null, can: ["CANH_BEN_BANG"]}, {ma: "DH06", ten: "Tứ giác có các cạnh đối song song là hình bình hành.", loai: "ket_luan", ghi_chu: "", tru_khi: [], ap_dung: "TU_GIAC", ket_luan: "HINH_BINH_HANH", can: ["SS_2_CAP"]}, {ma: "DH07", ten: "Tứ giác có các cạnh đối bằng nhau là hình bình hành.", loai: "ket_luan", ghi_chu: "", tru_khi: [], ap_dung: "TU_GIAC", ket_luan: "HINH_BINH_HANH", can: ["BANG_2_CAP"]}, {ma: "DH08", ten: "Tứ giác có hai cạnh đối song song và bằng nhau là hình bình hành.", loai: "ket_luan", ghi_chu: "", tru_khi: [], ap_dung: "TU_GIAC", ket_luan: "HINH_BINH_HANH", can: ["SS_VA_BANG"]}, {ma: "DH09", ten: "Tứ giác có các góc đối bằng nhau là hình bình hành.", loai: "ket_luan", ghi_chu: "", tru_khi: [], ap_dung: "TU_GIAC", ket_luan: "HINH_BINH_HANH", can: ["GOC_DOI_BANG"]}, {ma: "DH10", ten: "Tứ giác có hai đường chéo cắt nhau tại trung điểm của mỗi đường là hình bình hành.", loai: "ket_luan", ghi_chu: "", tru_khi: [], ap_dung: "TU_GIAC", ket_luan: "HINH_BINH_HANH", can: ["CHEO_TRUNG_DIEM"]}, {ma: "DH11", ten: "Tứ giác có ba góc vuông là hình chữ nhật.", loai: "ket_luan", ghi_chu: "", tru_khi: [], ap_dung: "TU_GIAC", ket_luan: "HINH_CHU_NHAT", can: ["BA_GOC_VUONG"]}, {ma: "DH12", ten: "Hình thang cân có một góc vuông là hình chữ nhật.", loai: "ket_luan", ghi_chu: "", tru_khi: [], ap_dung: "HINH_THANG_CAN", ket_luan: "HINH_CHU_NHAT", can: ["MOT_GOC_VUONG"]}, {ma: "DH13", ten: "Hình bình hành có một góc vuông là hình chữ nhật.", loai: "ket_luan", ghi_chu: "", tru_khi: [], ap_dung: "HINH_BINH_HANH", ket_luan: "HINH_CHU_NHAT", can: ["MOT_GOC_VUONG"]}, {ma: "DH14", ten: "Hình bình hành có hai đường chéo bằng nhau là hình chữ nhật.", loai: "ket_luan", ghi_chu: "", tru_khi: [], ap_dung: "HINH_BINH_HANH", ket_luan: "HINH_CHU_NHAT", can: ["CHEO_BANG"]}, {ma: "DH15", ten: "Tứ giác có bốn cạnh bằng nhau là hình thoi.", loai: "ket_luan", ghi_chu: "", tru_khi: [], ap_dung: "TU_GIAC", ket_luan: "HINH_THOI", can: ["BON_CANH_BANG"]}, {ma: "DH16", ten: "Hình bình hành có hai cạnh kề bằng nhau là hình thoi.", loai: "ket_luan", ghi_chu: "", tru_khi: [], ap_dung: "HINH_BINH_HANH", ket_luan: "HINH_THOI", can: ["HAI_CANH_KE_BANG"]}, {ma: "DH17", ten: "Hình bình hành có hai đường chéo vuông góc là hình thoi.", loai: "ket_luan", ghi_chu: "", tru_khi: [], ap_dung: "HINH_BINH_HANH", ket_luan: "HINH_THOI", can: ["CHEO_VUONG_GOC"]}, {ma: "DH18", ten: "Hình bình hành có một đường chéo là đường phân giác của một góc là hình thoi.", loai: "ket_luan", ghi_chu: "", tru_khi: [], ap_dung: "HINH_BINH_HANH", ket_luan: "HINH_THOI", can: ["CHEO_PHAN_GIAC"]}, {ma: "DH19", ten: "Hình chữ nhật có hai cạnh kề bằng nhau là hình vuông.", loai: "ket_luan", ghi_chu: "", tru_khi: [], ap_dung: "HINH_CHU_NHAT", ket_luan: "HINH_VUONG", can: ["HAI_CANH_KE_BANG"]}, {ma: "DH20", ten: "Hình chữ nhật có hai đường chéo vuông góc là hình vuông.", loai: "ket_luan", ghi_chu: "", tru_khi: [], ap_dung: "HINH_CHU_NHAT", ket_luan: "HINH_VUONG", can: ["CHEO_VUONG_GOC"]}, {ma: "DH21", ten: "Hình chữ nhật có một đường chéo là đường phân giác của một góc là hình vuông.", loai: "ket_luan", ghi_chu: "", tru_khi: [], ap_dung: "HINH_CHU_NHAT", ket_luan: "HINH_VUONG", can: ["CHEO_PHAN_GIAC"]}, {ma: "DH22", ten: "Hình thoi có một góc vuông là hình vuông.", loai: "ket_luan", ghi_chu: "", tru_khi: [], ap_dung: "HINH_THOI", ket_luan: "HINH_VUONG", can: ["MOT_GOC_VUONG"]}, {ma: "DH23", ten: "Hình thoi có hai đường chéo bằng nhau là hình vuông.", loai: "ket_luan", ghi_chu: "", tru_khi: [], ap_dung: "HINH_THOI", ket_luan: "HINH_VUONG", can: ["CHEO_BANG"]}, {ma: "DH24", ten: "Tứ giác có hai cặp cạnh kề bằng nhau là hình diều.", loai: "ket_luan", ghi_chu: "", tru_khi: [], ap_dung: "TU_GIAC", ket_luan: "HINH_DIEU", can: ["HAI_CAP_KE_BANG"]}, {ma: "DH25", ten: "Hình diều có một cặp cạnh đối song song là hình thoi.", loai: "ket_luan", ghi_chu: "", tru_khi: [], ap_dung: "HINH_DIEU", ket_luan: "HINH_THOI", can: ["SS_1_CAP"]}] AS r
MERGE (d:DauHieu {ma: r.ma})
SET d.ten = r.ten, d.loai = r.loai, d.ghi_chu = r.ghi_chu, d.tru_khi = r.tru_khi
WITH d, r
MATCH (h:Hinh {ma: r.ap_dung})
MERGE (d)-[:AP_DUNG_CHO]->(h)
WITH d, r
UNWIND r.can AS ma_tc
MATCH (t:TinhChat {ma: ma_tc})
MERGE (d)-[:CAN]->(t);

UNWIND [{ma: "DH01", ten: "Tứ giác có hai cạnh đối song song là hình thang.", loai: "ket_luan", ghi_chu: "", tru_khi: [], ap_dung: "TU_GIAC", ket_luan: "HINH_THANG", can: ["SS_1_CAP"]}, {ma: "DH02", ten: "Hình thang có một góc vuông là hình thang vuông.", loai: "ket_luan", ghi_chu: "", tru_khi: [], ap_dung: "HINH_THANG", ket_luan: "HINH_THANG_VUONG", can: ["MOT_GOC_VUONG"]}, {ma: "DH03", ten: "Hình thang có hai góc kề một đáy bằng nhau là hình thang cân.", loai: "ket_luan", ghi_chu: "", tru_khi: [], ap_dung: "HINH_THANG", ket_luan: "HINH_THANG_CAN", can: ["GOC_KE_DAY_BANG"]}, {ma: "DH04", ten: "Hình thang có hai đường chéo bằng nhau là hình thang cân.", loai: "ket_luan", ghi_chu: "", tru_khi: [], ap_dung: "HINH_THANG", ket_luan: "HINH_THANG_CAN", can: ["CHEO_BANG"]}, {ma: "DH05", ten: "Hình thang có hai cạnh bên bằng nhau và không song song là hình thang cân.", loai: "ket_luan", ghi_chu: "", tru_khi: [], ap_dung: "HINH_THANG", ket_luan: "HINH_THANG_CAN", can: ["CANH_BEN_BANG", "CANH_BEN_KHONG_SS"]}, {ma: "DH06", ten: "Tứ giác có các cạnh đối song song là hình bình hành.", loai: "ket_luan", ghi_chu: "", tru_khi: [], ap_dung: "TU_GIAC", ket_luan: "HINH_BINH_HANH", can: ["SS_2_CAP"]}, {ma: "DH07", ten: "Tứ giác có các cạnh đối bằng nhau là hình bình hành.", loai: "ket_luan", ghi_chu: "", tru_khi: [], ap_dung: "TU_GIAC", ket_luan: "HINH_BINH_HANH", can: ["BANG_2_CAP"]}, {ma: "DH08", ten: "Tứ giác có hai cạnh đối song song và bằng nhau là hình bình hành.", loai: "ket_luan", ghi_chu: "", tru_khi: [], ap_dung: "TU_GIAC", ket_luan: "HINH_BINH_HANH", can: ["SS_VA_BANG"]}, {ma: "DH09", ten: "Tứ giác có các góc đối bằng nhau là hình bình hành.", loai: "ket_luan", ghi_chu: "", tru_khi: [], ap_dung: "TU_GIAC", ket_luan: "HINH_BINH_HANH", can: ["GOC_DOI_BANG"]}, {ma: "DH10", ten: "Tứ giác có hai đường chéo cắt nhau tại trung điểm của mỗi đường là hình bình hành.", loai: "ket_luan", ghi_chu: "", tru_khi: [], ap_dung: "TU_GIAC", ket_luan: "HINH_BINH_HANH", can: ["CHEO_TRUNG_DIEM"]}