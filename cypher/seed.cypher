: "a", bieu_thuc: "sqrt(S)", ghi_chu: "", vao: ["S"], thu_tu: 6}, {ma: "CT_HINH_VUONG_07", hinh: "HINH_VUONG", loai: "canh", loai_ten: "Cạnh / đường trung bình", hien_thi: "a = P / 4", ket_qua: "a", bieu_thuc: "P / 4", ghi_chu: "", vao: ["P"], thu_tu: 7}, {ma: "CT_HINH_VUONG_08", hinh: "HINH_VUONG", loai: "duong_tron", loai_ten: "Đường tròn nội / ngoại tiếp", hien_thi: "R = d / 2", ket_qua: "R", bieu_thuc: "d / 2", ghi_chu: "", vao: ["d"], thu_tu: 8}, {ma: "CT_HINH_VUONG_09", hinh: "HINH_VUONG", loai: "duong_tron", loai_ten: "Đường tròn nội / ngoại tiếp", hien_thi: "r = a / 2", ket_qua: "r", bieu_thuc: "a / 2", ghi_chu: "", vao: ["a"], thu_tu: 9}, {ma: "CT_HINH_DIEU_01", hinh: "HINH_DIEU", loai: "dien_tich", loai_ten: "Diện tích", hien_thi: "S = ½ · d₁ · d₂", ket_qua: "S", bieu_thuc: "0.5 * d1 * d2", ghi_chu: "Hai đường chéo của hình diều vuông góc.", vao: ["d1", "d2"], thu_tu: 1}, {ma: "CT_HINH_DIEU_02", hinh: "HINH_DIEU", loai: "chu_vi", loai_ten: "Chu vi", hien_thi: "P = 2 · (a + b)", ket_qua: "P", bieu_thuc: "2 * (a + b)", ghi_chu: "", vao: ["a", "b"], thu_tu: 2}, {ma: "CT_HINH_DIEU_03", hinh: "HINH_DIEU", loai: "duong_cheo", loai_ten: "Đường chéo", hien_thi: "d₁ = √(a² − (d₂/2)²) + √(b² − (d₂/2)²)", ket_qua: "d1", bieu_thuc: "sqrt(a**2 - (d2 / 2)**2) + sqrt(b**2 - (d2 / 2)**2)", ghi_chu: "AC chia BD thành hai nửa bằng nhau và vuông góc với BD (Pytago).", vao: ["a", "b", "d2"], thu_tu: 3}] AS r
MATCH (h:Hinh {ma: r.hinh})
MERGE (c:CongThuc {ma: r.ma})
SET c.loai = r.loai, c.loai_ten = r.loai_ten, c.hien_thi = r.hien_thi,
c.bieu_thuc = r.bieu_thuc, c.ghi_chu = r.ghi_chu, c.thu_tu = r.thu_tu
MERGE (h)-[:CO_CONG_THUC]->(c)
WITH c, r
MATCH (k:DaiLuong {ma: r.hinh + '.' + r.ket_qua})
MERGE (c)-[:TINH_RA]->(k)
WITH c, r
UNWIND r.vao AS bien
MATCH (v:DaiLuong {ma: r.hinh + '.' + bien})
MERGE (c)-[:CAN_BIEN]->(v);
